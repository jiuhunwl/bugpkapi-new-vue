# 生产构建自动读取根目录 VERSION；发布脚本可通过 VITE_APP_VERSION 覆盖。

# 在应用脚本加载和异步初始化期间显示首屏 loading，避免出现空白页面
VITE_INJECT_APP_LOADING=true

# 同域生产部署时，所有管理端请求必须走后端 API 前缀，不能落入前端 SPA 回退。
# 分离部署/直连后端时由 build-backend-release.ps1 在构建时覆盖为绝对地址。
VITE_GLOB_API_URL=/system-api

VITE_APP_SITE_URL=https://api.example.com
VITE_APP_DESCRIPTION=BugPk-Api open API service platform，提供接口调用、计费、市场与文档服务。
VITE_APP_KEYWORDS=BugPk-Api,API接口,开放API,API市场,接口文档,API计费,开发者平台
VITE_APP_OG_IMAGE=https://static.example.com/img/bugpk-Api-256%C3%97256.ico
VITE_APP_VERSION=v1.2.108
