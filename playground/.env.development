# 端口号
VITE_PORT=5555

VITE_BASE=/

# Local development defaults for the metadata placeholders in index.html.
VITE_APP_SITE_URL=http://127.0.0.1:5555
VITE_APP_DESCRIPTION=BugPk-Api open API service platform for API calls, billing, marketplace, and documentation.
VITE_APP_KEYWORDS=BugPk-Api,API,open API,API marketplace,API documentation,API billing,developer platform
VITE_APP_OG_IMAGE=/favicon.ico

# 接口地址
VITE_GLOB_API_URL=/system-api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 钉钉登录配置
VITE_GLOB_AUTH_DINGDING_CLIENT_ID=应用的clientId
VITE_GLOB_AUTH_DINGDING_CORP_ID=应用的corpId
